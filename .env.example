# Copia aquest fitxer a .env.local i emplena els valors del teu projecte Supabase.
# Mai commitejar .env.local al repositori.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxx

# Només per al script de generació de tipus (npm run gen:types), mai exposat al client:
SUPABASE_PROJECT_ID=xxxxxxxxxxxxxxxxxxxxx

# URL pública final del lloc, sense barra final. Es fa servir per generar
# les URLs canòniques, el sitemap i les etiquetes Open Graph de la landing.
# Durant la beta pots deixar-hi la URL que et doni Vercel (p. ex.
# https://logoupendi365.vercel.app); actualitza-ho quan tinguis domini propi.
NEXT_PUBLIC_SITE_URL=https://logoupendi365.vercel.app

# Secret per protegir la ruta de cron (/api/cron/keep-alive) perquè ningú
# més la pugui cridar des de fora. Genera'n un de qualsevol manera (p. ex.
# a una terminal: openssl rand -hex 32) i enganxa'l aquí I a Vercel —
# Vercel afegeix automàticament la capçalera Authorization amb aquest
# valor quan crida la ruta de cron.
CRON_SECRET=canvia-aquest-valor-per-un-de-aleatori
